#!/bin/bash
# ==============================================================================
# AeroGaming OS Build Hook: 01-setup-multiarch-and-gaming
# ==============================================================================
set -e

echo "[Hook 01] Enabling i386 multiarch for Steam and Wine compatibility..."
dpkg --add-architecture i386
apt-get update

echo "[Hook 01] Installing 32-bit Vulkan and Mesa graphic drivers..."
apt-get install -y --no-install-recommends \
    libgl1-mesa-dri:i386 \
    mesa-vulkan-drivers:i386 \
    libvulkan1:i386 \
    libc6:i386 \
    libstdc++6:i386 || true

echo "[Hook 01] Multiarch gaming stack configured."

