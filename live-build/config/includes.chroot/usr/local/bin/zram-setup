#!/bin/bash
# ==============================================================================
# AeroGaming OS - Dynamic ZRAM Swap Initializer
# Specifically engineered for 4 GB RAM systems
# ==============================================================================

set -e

# Load zram kernel module with 1 stream per core
modprobe zram num_devices=1 2>/dev/null || true

# Determine RAM size in bytes
TOTAL_RAM=$(grep MemTotal /proc/meminfo | awk '{print $2 * 1024}')

# Target 100% of RAM as ZRAM block size
# On a 4 GB RAM machine, this provides 4 GB of compressed memory (~1.3 GB real RAM usage)
ZRAM_SIZE=$TOTAL_RAM

# Initialize /dev/zram0
if [ -e /sys/block/zram0 ]; then
    # Reset existing zram device
    swapoff /dev/zram0 2>/dev/null || true
    echo 1 > /sys/block/zram0/reset 2>/dev/null || true

    # Configure modern zstd compression (fallback to lzo-rle if zstd not available in kernel)
    if grep -q zstd /sys/block/zram0/comp_algorithm; then
        echo zstd > /sys/block/zram0/comp_algorithm
    elif grep -q lzo-rle /sys/block/zram0/comp_algorithm; then
        echo lzo-rle > /sys/block/zram0/comp_algorithm
    fi

    # Set disksize
    echo $ZRAM_SIZE > /sys/block/zram0/disksize

    # Format and activate swap with maximum priority (32767)
    mkswap /dev/zram0 >/dev/null 2>&1
    swapon -p 32767 /dev/zram0
    
    echo "AeroGaming OS: ZRAM 0 activated with size $(($ZRAM_SIZE / 1024 / 1024)) MB (Priority: 32767)."
fi

