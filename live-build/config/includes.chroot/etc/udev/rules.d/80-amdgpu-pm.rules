# ==============================================================================
# AeroGaming OS - AMD Radeon Vega 3 Power & Sysfs Rules
# Allows GameMode and Control Center to adjust GPU performance levels
# ==============================================================================

ACTION=="add", SUBSYSTEM=="pci", DRIVER=="amdgpu", ATTR{power_dpm_force_performance_level}="auto"
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", GROUP="video", MODE="0664"
ACTION=="add", SUBSYSTEM=="drm", KERNEL=="card*", RUN+="/bin/chmod a+w /sys/class/drm/%k/device/power_dpm_force_performance_level"

